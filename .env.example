# Google Meet bot self-host config
MEET_URL=https://meet.google.com/xxx-xxxx-xxx
BOT_NAME=Algo Recording Bot
TEAM_ID=local-team
USER_ID=local-user
EVENT_ID=local-event
BOT_ID=local-bot
BEARER_TOKEN=local-token
TIMEZONE=Asia/Ho_Chi_Minh

# Recording behavior
MAX_RECORDING_DURATION_MINUTES=60
JOIN_WAIT_TIME_MINUTES=5
INACTIVITY_LIMIT_MINUTES=10
ACTIVATE_INACTIVITY_DETECTION_AFTER_MINUTES=5

# Browser
HEADLESS=false
RECORDING_DIR=./recordings
DEBUG_IMAGE_DIR=./debug-images

# Optional backend callback; leave empty for standalone mode
SCREENAPP_BACKEND_URL=
